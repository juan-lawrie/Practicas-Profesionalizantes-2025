@startuml Diagrama_de_Clases_Churreria

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam shadowing false
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam arrowColor Black
skinparam groupInheritance 2

' =============================================
'  BASE ABSTRACTA DE DJANGO
' =============================================
abstract class AbstractUser <<Django>> {
  #id : int
  #username : String
  #email : String
  #password : String
  #first_name : String
  #last_name : String
  #is_active : bool
  #is_staff : bool
  #is_superuser : bool
  #date_joined : datetime
  --
  +check_password(raw) : bool
  +set_password(raw)
}

' =============================================
'  USUARIOS Y ROLES
' =============================================
class Usuario {
  -failed_login_attempts : int
  -is_locked : bool
  -locked_at : datetime
  -lock_type : String
  --
  +iniciarSesion(email, password) : Token
  +cerrarSesion()
  +cambiarContrasena(nueva_contrasena)
  +bloquear()
  +desbloquear()
}

class Rol {
  -id : int
  -nombre : String
  --
  +asignarUsuario(usuario)
  +modificarPermisos()
}

class AlmacenamientoUsuario {
  -id : int
  -clave : String
  -valor : JSON
  -updated_at : datetime
  --
  +guardar(clave, valor)
  +cargar(clave) : JSON
  +eliminar(clave)
}

class TokenRestablecimiento {
  -id : UUID
  -token_hash : String
  -created_at : datetime
  -expires_at : datetime
  -used : bool
  -nota : String
  --
  +validar() : bool
  +marcarUsado()
  +expirado() : bool
}

AbstractUser <|-- Usuario
Usuario "0..*" --> "1" Rol : tiene >
Usuario "1" *-- "0..*" AlmacenamientoUsuario : almacena >
Usuario "1" --> "0..*" TokenRestablecimiento : genera (gerente) >
Usuario "1" --> "0..*" TokenRestablecimiento : es destinatario >

' =============================================
'  PRODUCTOS, MATERIAS PRIMAS Y RECETAS
' =============================================
class Producto {
  -id : int
  -nombre : String
  -descripcion : String
  -precio : Decimal
  -stock : Decimal
  -stockMinimo : int
  -stockAltoMultiplicador : Decimal
  -categoria : String
  -unidad : String  <<g | ml | unidades>>
  -rendimientoReceta : int
  -tasaPerdida : Decimal
  -is_active : bool
  -deleted_at : datetime
  --
  +verificarStockBajo() : bool
  +actualizarStock(cantidad, tipo)
  +desactivar()
}

class MateriaPrima {
  -es_insumo : bool = true
  --
  +calcularStockNecesario(unidades) : Decimal
  +verificarStockBajo() : bool
}

class RecetaProducto {
  -id : int
  -cantidad : Decimal
  -unidad : String  <<g | ml | unidades>>
  --
  +calcularCantidadNecesaria(unidades) : Decimal
}

Producto <|-- MateriaPrima
RecetaProducto "0..*" --> "1" Producto : elabora >
RecetaProducto "0..*" --> "1" MateriaPrima : usa >

' =============================================
'  PROVEEDORES
' =============================================
class Proveedor {
  -id : int
  -nombre : String
  -cuit : String
  -direccion : String
  -telefono : String
  -productosQueProvee : String
  -is_active : bool
  -deleted_at : datetime
  --
  +proveerMateriasPrimas()
  +recibirPagos()
  +desactivar()
}

Proveedor "0..*" --> "0..*" MateriaPrima : provee >

' =============================================
'  VENTAS
' =============================================
class Venta {
  -id : int
  -fecha : datetime
  -montoTotal : Decimal
  -metodoPago : String
  --
  +registrarVenta()
  +generarRecibo()
  +actualizarStock()
}

class Detalle_de_Venta {
  -id : int
  -cantidad : int
  -precioUnitario : Decimal
  --
  +calcularSubtotal() : Decimal
  +actualizarStockSalida()
}

Usuario "1" --> "0..*" Venta : registra >
Venta "1" *-- "1..*" Detalle_de_Venta : contiene >
Detalle_de_Venta "0..*" --> "1" Producto : referencia >

' =============================================
'  COMPRAS
' =============================================
class Compra {
  -id : int
  -fecha : String
  -montoTotal : Decimal
  -estado : String  <<Pendiente | Aprobada | Rechazada>>
  -created_at : datetime
  -approved_at : datetime
  -is_active : bool
  -deleted_at : datetime
  --
  +registrarCompra()
  +aprobar()
  +rechazar()
  +actualizarStock()
  +generarOrden()
}

class Detalle_de_Compra {
  -nombreProducto : String
  -cantidad : Decimal
  -precioUnitario : Decimal
  -unidad : String
  --
  +calcularSubtotal() : Decimal
  +actualizarStockEntrada()
}

Usuario "1" --> "0..*" Compra : solicita >
Usuario "1" --> "0..*" Compra : aprueba >
Compra "0..*" --> "1" Proveedor : realizadaA >
Compra "1" *-- "1..*" Detalle_de_Compra : contiene >
Detalle_de_Compra "0..*" --> "1" MateriaPrima : referencia >

' =============================================
'  PEDIDOS DE CLIENTES
' =============================================
class PedidoDeProductos {
  -id : int
  -nombreCliente : String
  -fechaEntrega : datetime
  -metodoPago : String
  -montoTotal : Decimal
  -notas : String
  -estado : String
  -fechaOrden : datetime
  --
  +registrarPedido()
  +actualizarEstado(estado)
  +generarRecibo()
}

class DetallePedido {
  -id : int
  -nombreProducto : String
  -cantidad : int
  -precioUnitario : Decimal
  -total : Decimal
  --
  +calcularTotal() : Decimal
}

Usuario "1" --> "0..*" PedidoDeProductos : gestiona >
PedidoDeProductos "1" *-- "1..*" DetallePedido : contiene >
DetallePedido "0..*" --> "1" Producto : referencia >

' =============================================
'  MOVIMIENTOS DE STOCK
' =============================================
class Movimiento_Stock {
  -id : int
  -tipo : String  <<Entrada | Salida>>
  -cantidad : Decimal
  -motivo : String
  -timestamp : datetime
  --
  +registrarEntrada()
  +registrarSalida()
}

class AuditoriaMovimientoStock {
  -id : int
  -rolUsuario : String
  -tipoCambio : String  <<Entrada | Salida>>
  -cantidad : Decimal
  -stockPrevio : Decimal
  -stockNuevo : Decimal
  -motivo : String
  -timestamp : datetime
  --
  +generarRegistro()
  +obtenerHistorial() : List
}

Usuario "1" --> "0..*" Movimiento_Stock : realiza >
Movimiento_Stock "0..*" --> "1" Producto : afecta >
Movimiento_Stock "1" *-- "0..*" AuditoriaMovimientoStock : genera >
AuditoriaMovimientoStock "0..*" --> "1" Producto : registra >
AuditoriaMovimientoStock "0..*" --> "1" Usuario : realizadoPor >

' =============================================
'  PRODUCCIÓN
' =============================================
class OrdenProduccion {
  -id : int
  -fecha : datetime
  -totalUnidades : int
  --
  +registrarProduccion()
  +calcularInsumos()
  +ejecutarLote()
}

class DetalleProduccion {
  -id : int
  -cantidad : int
  --
  +calcularInsumosNecesarios() : Decimal
}

Usuario "1" --> "0..*" OrdenProduccion : ejecuta >
OrdenProduccion "1" *-- "1..*" DetalleProduccion : contiene >
DetalleProduccion "0..*" --> "1" Producto : produce >

' =============================================
'  PAGOS / MOVIMIENTOS DE CAJA
' =============================================
class Pago {
  -id : int
  -tipo : String  <<Entrada | Salida>>
  -monto : Decimal
  -descripcion : String
  -metodoPago : String
  -fecha : datetime
  --
  +procesarPago()
  +generarRecibo()
  +conciliarPagos()
}

Usuario "1" --> "0..*" Pago : registra >

' =============================================
'  REPORTES Y ALERTAS  (CLASES NUEVAS)
' =============================================
class ReporteStockBajo {
  -id : int
  -mensaje : String
  -created_at : datetime
  -is_resolved : bool
  --
  +generarReporte()
  +resolver()
  +notificarGerente()
}

class RegistroPerdida {
  -id : int
  -cantidad : Decimal
  -categoria : String
  -descripcion : String
  -costoEstimado : Decimal
  -timestamp : datetime
  --
  +registrarPerdida()
  +calcularImpacto() : Decimal
  +obtenerCategoria() : String
}

class ConsultaUsuario {
  -id : int
  -tipoConsulta : String
  -fechaInicio : date
  -fechaFin : date
  -datosResultado : JSON
  -created_at : datetime
  -updated_at : datetime
  --
  +guardarConsulta()
  +actualizarConsulta()
  +limpiarConsulta()
}

Usuario "1" --> "0..*" ReporteStockBajo : reporta >
ReporteStockBajo "0..*" --> "0..*" Producto : sobre >
Usuario "1" --> "0..*" RegistroPerdida : registra >
RegistroPerdida "0..*" --> "1" Producto : afecta >
Usuario "1" *-- "0..*" ConsultaUsuario : guarda >

@enduml
